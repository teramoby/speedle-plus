[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C=cn
ST=Beijing
L=Beijing
O=Default Company Ltd
CN=localhost
emailAddress=bill828@gmail.com

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:TRUE

[alt_names]
DNS.1 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1
